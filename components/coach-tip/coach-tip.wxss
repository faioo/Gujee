.tip {
  margin: 24rpx 32rpx;
  padding: 24rpx 28rpx;
  background: #fff;
  border-radius: 20rpx;
  border: 2rpx solid #f3c9a8;
  box-shadow: 0 8rpx 24rpx rgba(224, 122, 61, 0.08);
}

.label {
  display: block;
  font-size: 22rpx;
  color: #e07a3d;
  font-weight: 700;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.body {
  display: block;
  font-size: 28rpx;
  color: #2c241b;
  line-height: 1.55;
}
