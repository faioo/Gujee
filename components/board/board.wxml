<view
  class="board"
  style="--n: {{size}};"
  bindtouchmove="onTouchMove"
  bindtouchend="onTouchEnd"
  bindtouchcancel="onTouchEnd"
>
  <block wx:for="{{board}}" wx:for-item="row" wx:for-index="r" wx:key="r">
    <view class="row">
      <block wx:for="{{row}}" wx:for-item="cell" wx:for-index="c" wx:key="c">
        <view
          class="cell {{conflictMap[r + '-' + c] ? 'conflict' : ''}} {{highlight && highlight.r === r && highlight.c === c ? 'hl' : ''}} {{colorWeak ? 'weak' : ''}} {{size >= 10 ? 'dense' : ''}}"
          style="background-color: {{colors[regions[r][c]]}};"
          data-r="{{r}}"
          data-c="{{c}}"
          bindtap="onCellTap"
          bindtouchstart="onTouchStart"
        >
          <view wx:if="{{colorWeak}}" class="motif-layer">
            <text class="motif">{{motifGlyphs[r][c]}}</text>
          </view>
          <text wx:if="{{cell === 'mark'}}" class="sym mark">×</text>
          <text wx:elif="{{cell === 'wrong'}}" class="sym wrong">×</text>
          <view wx:elif="{{cell === 'place'}}" class="sym place">
            <view class="bird"></view>
          </view>
        </view>
      </block>
    </view>
  </block>
</view>
