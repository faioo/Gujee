.board {
  width: 100%;
  max-width: 680rpx;
  margin: 0 auto;
  border: 4rpx solid #2c241b;
  border-radius: 16rpx;
  overflow: hidden;
  background: #2c241b;
  box-shadow: 0 12rpx 32rpx rgba(44, 36, 27, 0.12);
}

.row {
  display: flex;
  flex-direction: row;
}

.cell {
  flex: 1;
  aspect-ratio: 1;
  border: 1rpx solid rgba(44, 36, 27, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.cell.conflict {
  box-shadow: inset 0 0 0 4rpx #d64545;
}

.cell.hl {
  animation: pulse 1.1s ease-in-out infinite;
  z-index: 1;
}

@keyframes pulse {
  0%,
  100% {
    box-shadow: inset 0 0 0 4rpx #e07a3d;
  }
  50% {
    box-shadow: inset 0 0 0 8rpx #e07a3d, 0 0 0 4rpx rgba(224, 122, 61, 0.35);
  }
}

.sym {
  position: relative;
  z-index: 1;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}

.mark {
  font-size: 56rpx;
  font-weight: 800;
  color: rgba(44, 36, 27, 0.78);
}

.cell.dense .mark {
  font-size: 44rpx;
}

.wrong {
  font-size: 60rpx;
  font-weight: 800;
  color: #d64545;
}

.cell.dense .wrong {
  font-size: 48rpx;
}

.place {
  position: relative;
  z-index: 1;
  width: 56%;
  height: 56%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bird {
  width: 100%;
  height: 100%;
  border-radius: 50% 50% 45% 45%;
  background: #2c241b;
  position: relative;
}

.bird::before {
  content: '';
  position: absolute;
  right: -18%;
  top: 36%;
  width: 28%;
  height: 22%;
  background: #e07a3d;
  clip-path: polygon(0 0, 100% 50%, 0 100%);
}

.motif-layer {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  z-index: 0;
  opacity: 0.32;
}

.motif {
  font-size: 56rpx;
  line-height: 1;
  text-align: center;
  color: #2c241b;
}

.cell.dense .motif {
  font-size: 40rpx;
}
