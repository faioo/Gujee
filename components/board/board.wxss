.board {
  width: 100%;
  max-width: 680rpx;
  margin: 0 auto;
  border: 4rpx solid #2c241b;
  border-radius: 16rpx;
  overflow: hidden;
  background: #2c241b;
  box-shadow: 0 12rpx 32rpx rgba(44, 36, 27, 0.12);
}

.row {
  display: flex;
  flex-direction: row;
}

.cell {
  flex: 1;
  aspect-ratio: 1;
  border: 1rpx solid rgba(44, 36, 27, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.cell.conflict {
  box-shadow: inset 0 0 0 4rpx #d64545;
}

.cell.hl {
  animation: pulse 1.1s ease-in-out infinite;
  z-index: 1;
}

@keyframes pulse {
  0%,
  100% {
    box-shadow: inset 0 0 0 4rpx #e07a3d;
  }
  50% {
    box-shadow: inset 0 0 0 8rpx #e07a3d, 0 0 0 4rpx rgba(224, 122, 61, 0.35);
  }
}

.sym {
  position: relative;
  z-index: 1;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}

.mark {
  color: rgba(44, 36, 27, 0.55);
}

.place {
  position: relative;
  z-index: 1;
  width: 56%;
  height: 56%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bird {
  width: 100%;
  height: 100%;
  border-radius: 50% 50% 45% 45%;
  background: #2c241b;
  position: relative;
}

.bird::before {
  content: '';
  position: absolute;
  right: -18%;
  top: 36%;
  width: 28%;
  height: 22%;
  background: #e07a3d;
  clip-path: polygon(0 0, 100% 50%, 0 100%);
}

.region-id {
  position: absolute;
  left: 6rpx;
  top: 2rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: rgba(44, 36, 27, 0.55);
  z-index: 0;
  line-height: 1.2;
}

.cell.weak.pattern-0 {
  background-image: repeating-linear-gradient(
    45deg,
    rgba(44, 36, 27, 0.22) 0,
    rgba(44, 36, 27, 0.22) 6rpx,
    transparent 6rpx,
    transparent 14rpx
  );
}

.cell.weak.pattern-1 {
  background-image: repeating-linear-gradient(
    -45deg,
    rgba(44, 36, 27, 0.22) 0,
    rgba(44, 36, 27, 0.22) 6rpx,
    transparent 6rpx,
    transparent 14rpx
  );
}

.cell.weak.pattern-2 {
  background-image: repeating-linear-gradient(
    0deg,
    rgba(44, 36, 27, 0.2) 0,
    rgba(44, 36, 27, 0.2) 5rpx,
    transparent 5rpx,
    transparent 12rpx
  );
}

.cell.weak.pattern-3 {
  background-image: repeating-linear-gradient(
    90deg,
    rgba(44, 36, 27, 0.2) 0,
    rgba(44, 36, 27, 0.2) 5rpx,
    transparent 5rpx,
    transparent 12rpx
  );
}

.cell.weak.pattern-4 {
  background-image: radial-gradient(
    rgba(44, 36, 27, 0.28) 22%,
    transparent 24%
  );
  background-size: 16rpx 16rpx;
}

.cell.weak.pattern-5 {
  background-image:
    repeating-linear-gradient(
      0deg,
      rgba(44, 36, 27, 0.16) 0,
      rgba(44, 36, 27, 0.16) 4rpx,
      transparent 4rpx,
      transparent 12rpx
    ),
    repeating-linear-gradient(
      90deg,
      rgba(44, 36, 27, 0.16) 0,
      rgba(44, 36, 27, 0.16) 4rpx,
      transparent 4rpx,
      transparent 12rpx
    );
}

.cell.weak.pattern-6 {
  background-image: repeating-linear-gradient(
    135deg,
    rgba(44, 36, 27, 0.28) 0 8rpx,
    transparent 8rpx 20rpx
  );
}

.cell.weak.pattern-7 {
  background-image: radial-gradient(
    closest-side,
    rgba(44, 36, 27, 0.3),
    rgba(44, 36, 27, 0.3) 40%,
    transparent 42%
  );
  background-size: 22rpx 22rpx;
  background-position: 0 0, 11rpx 11rpx;
}
