{
  "description": "咕叽咕叽 / Goojee",
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": "node_modules"
      },
      {
        "type": "folder",
        "value": "__tests__"
      },
      {
        "type": "folder",
        "value": "docs"
      },
      {
        "type": "file",
        "value": "jest.config.js"
      },
      {
        "type": "file",
        "value": "package-lock.json"
      },
      {
        "type": "file",
        "value": "README.md"
      }
    ],
    "include": []
  },
  "setting": {
    "bundle": false,
    "es6": true,
    "postcss": true,
    "minified": true,
    "enhance": true,
    "showShadowRootInWxmlPanel": true,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    },
    "useCompilerPlugins": [
      "typescript"
    ],
    "compileWorklet": false,
    "uglifyFileName": false,
    "uploadWithSourceMap": true,
    "packNpmManually": false,
    "packNpmRelationList": [],
    "minifyWXSS": true,
    "minifyWXML": true,
    "localPlugins": false,
    "disableUseStrict": false,
    "condition": false,
    "swc": false,
    "disableSWC": true,
    "ignoreDevUnusedFiles": true
  },
  "compileType": "miniprogram",
  "libVersion": "3.7.12",
  "appid": "touristappid",
  "projectname": "goojee",
  "condition": {},
  "editorSetting": {
    "tabIndent": "insertSpaces",
    "tabSize": 2
  }
}
