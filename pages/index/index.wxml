<view class="page">
  <view class="hero">
    <view class="orb"></view>
    <text class="brand">{{brand}}</text>
    <text class="brand-en">{{brandEn}}</text>
    <text class="tagline">彩色区域里，安放每一只咕叽</text>
  </view>

  <view class="actions">
    <button class="btn primary" bindtap="goLevels">开始解谜</button>
    <button class="btn ghost" bindtap="replayTutorial">重玩教学</button>
  </view>

  <view class="rules">
    <text class="rules-title">三句话学会</text>
    <text class="rule">每行、每列、每个色块各放 1 只咕叽</text>
    <text class="rule">咕叽之间不能相邻（含斜角）</text>
    <text class="rule">点格子：空 → × → 咕叽 → 空</text>
  </view>

  <view class="settings">
    <text class="settings-title">设置</text>
    <view class="setting-row" wx:if="{{autoMarkUnlocked}}">
      <view class="setting-copy">
        <text class="setting-name">自动清死格</text>
        <text class="setting-desc">放置后自动标 × 不可能的格子</text>
      </view>
      <switch checked="{{autoMarkDeadCells}}" color="#e07a3d" bindchange="onAutoMarkChange" />
    </view>
    <view class="setting-row locked" wx:else>
      <view class="setting-copy">
        <text class="setting-name">自动清死格</text>
        <text class="setting-desc">成就或会员解锁后可开启</text>
      </view>
      <text class="lock-badge">未解锁</text>
    </view>
    <view class="setting-row">
      <view class="setting-copy">
        <text class="setting-name">色弱模式</text>
        <text class="setting-desc">用纹理和编号区分色块，不单靠颜色</text>
      </view>
      <switch checked="{{colorWeakMode}}" color="#e07a3d" bindchange="onColorWeakChange" />
    </view>
  </view>
</view>
