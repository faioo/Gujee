.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 80rpx;
  background: linear-gradient(180deg, #fff8f0 0%, #ffe8d4 100%);
}

.section {
  margin-bottom: 36rpx;
}

.section-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #7a6a5a;
  margin: 12rpx 8rpx 16rpx;
  letter-spacing: 2rpx;
}

.card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 20rpx;
  border: 2rpx solid rgba(243, 201, 168, 0.7);
}

.left {
  flex: 1;
  min-width: 0;
}

.name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #2c241b;
}

.meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7a6a5a;
}

.badge {
  font-size: 24rpx;
  color: #e07a3d;
  font-weight: 700;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #fff3e8;
}

.badge.done {
  color: #3d9a6a;
  background: #e7f6ee;
}
