<view class="page">
  <view class="section">
    <text class="section-title">教学</text>
    <block wx:for="{{tutorials}}" wx:key="id">
      <view class="card" data-id="{{item.id}}" bindtap="openLevel">
        <view class="left">
          <text class="name">{{item.name}}</text>
          <text class="meta">{{item.size}}×{{item.size}} · {{item.difficultyLabel}}</text>
        </view>
        <text class="badge {{item.done ? 'done' : ''}}">{{item.done ? '完成' : '开始'}}</text>
      </view>
    </block>
  </view>

  <view class="section">
    <text class="section-title">正式关卡</text>
    <block wx:for="{{normals}}" wx:key="id">
      <view class="card" data-id="{{item.id}}" bindtap="openLevel">
        <view class="left">
          <text class="name">{{item.name}}</text>
          <text class="meta">{{item.size}}×{{item.size}} · {{item.difficultyLabel}}</text>
        </view>
        <text class="badge {{item.done ? 'done' : ''}}">{{item.done ? '完成' : '开始'}}</text>
      </view>
    </block>
  </view>
</view>
