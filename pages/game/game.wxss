.page {
  min-height: 100vh;
  padding-bottom: 80rpx;
  background: linear-gradient(180deg, #fff8f0 0%, #ffe8d4 100%);
}

.top {
  display: flex;
  justify-content: flex-end;
  padding: 12rpx 32rpx 0;
}

.skip {
  font-size: 26rpx;
  color: #7a6a5a;
  padding: 12rpx 16rpx;
}

.board-wrap {
  padding: 12rpx 32rpx 24rpx;
}

.hint-line {
  padding: 0 32rpx 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #7a6a5a;
}

.toolbar {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 32rpx;
}

.tool {
  flex: 1;
  height: 80rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 2rpx solid #f3c9a8;
  color: #2c241b;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hint-note {
  text-align: center;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #e07a3d;
}
