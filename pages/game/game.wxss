.page {
  min-height: 100vh;
  padding-bottom: 80rpx;
  background: linear-gradient(180deg, #fff8f0 0%, #ffe8d4 100%);
}

.top {
  display: flex;
  justify-content: flex-end;
  padding: 12rpx 32rpx 0;
}

.skip {
  font-size: 26rpx;
  color: #7a6a5a;
  padding: 12rpx 16rpx;
}

.board-wrap {
  padding: 12rpx 32rpx 24rpx;
}

.hint-line {
  padding: 0 32rpx 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #7a6a5a;
}

.toolbar {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 32rpx;
}

.tool {
  flex: 1;
  height: 80rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 2rpx solid #f3c9a8;
  color: #2c241b;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hint-note {
  text-align: center;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #e07a3d;
}

.settings {
  margin: 28rpx 32rpx 0;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  border-radius: 24rpx;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.setting-row + .setting-row {
  margin-top: 20rpx;
}

.setting-row.locked {
  opacity: 0.7;
}

.setting-copy {
  flex: 1;
  min-width: 0;
}

.setting-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #2c241b;
}

.setting-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #7a6a5a;
}

.lock-badge {
  font-size: 22rpx;
  color: #7a6a5a;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f3ece4;
}
